---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Contour from '../components/Contour.astro';
import Ticker from '../components/Ticker.astro';
import Arrow from '../components/Arrow.astro';
import SocialIcon from '../components/SocialIcon.astro';
import WorkList from '../components/WorkList.astro';
import { site, skills, socials } from '../site';
import portrait from '../assets/photos/header.png';
import profile from '../assets/photos/profile.png';
import chef from '../assets/photos/chef.jpg';
import dish from '../assets/photos/castle-dish.jpg';
import artsy from '../assets/photos/artsy.jpg';

const featured = (await getCollection('work', ({ data }) => data.featured && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const total = (await getCollection('work', ({ data }) => !data.draft)).length;

const facts = [
  {
    tag: 'Work',
    title: 'Fullstack engineer',
    text: 'At Dreamplan I build the frontend of a pension advisory platform: TypeScript, React and Next.js in a Turborepo, with a design system in Storybook holding it all together.',
  },
  {
    tag: 'Games',
    title: 'Game studio',
    text: 'I run Kinda Whimsical Games with my partner Julie. I do the programming and the music, mostly in React Three Fiber, Electron and SpacetimeDB.',
  },
  {
    tag: 'Music',
    title: 'Music production',
    text: 'Producer and composer for years: my own music, other artists, theatre and film. These days a lot of it ends up in our games.',
  },
  {
    tag: 'Food',
    title: 'Former head chef',
    text: 'From 2017 to 2024 I cooked at places like Noma, Alchemist and Copenhague in Paris, ending as head chef at Frederiksborg Castle. It taught me precision, pace and teamwork.',
  },
  {
    tag: 'Personal',
    title: 'Passions',
    text: "Most of my time goes to my partner, friends, cooking, music and whatever I'm building next. Usually there's something I'm building next.",
  },
  {
    tag: 'Look around',
    title: 'Take a look around!',
    text: "There are case studies, playable game footage and a CV in here. Do have a look around, and say hello if something catches your eye.",
  },
];

const journey = [
  {
    img: chef,
    alt: 'Sebastian cooking in a professional kitchen',
    years: '2017 – 2024',
    title: 'The kitchen',
    text: 'Noma, Alchemist and Copenhague in Paris, where the team earned two Michelin stars, then head chef at Frederiksborg Castle, running a team and the systems behind it.',
  },
  {
    img: artsy,
    alt: 'Illustrated portrait of Sebastian',
    years: 'Always',
    title: 'The studio',
    text: 'Music the whole way through: producing and writing for labels and artists, editing for a production company, and four months scoring a Sartre play for the theatre.',
  },
  {
    img: dish,
    alt: 'A plated dish being finished with herbs',
    years: '2025 – now',
    title: 'The code',
    text: 'Web developer education at RTS while interning at Dreamplan, then full time as a fullstack engineer from October 2026. Same craft as the kitchen: details, timing and making something people enjoy.',
  },
];
---

<Base>
  <!-- ---------- Hero ---------- -->
  <section class="hero" data-contour-area aria-labelledby="hero-name">
    <div class="hero-card">
      <Contour tone="light" density={10} />
      <div class="hero-top">
        <p class="mono">{site.location}</p>
        <p class="mono status"><span class="dot" aria-hidden="true"></span> Currently building at Dreamplan</p>
      </div>
      <figure class="hero-portrait">
        <Image
          src={portrait}
          alt="Sebastian Køster, seen from behind, looking up at the sky"
          widths={[480, 800, 1100]}
          sizes="(min-width: 900px) 30vw, 60vw"
          loading="eager"
          fetchpriority="high"
          data-parallax="6"
        />
      </figure>
      <div class="hero-bottom">
        <h1 id="hero-name" class="hero-name" data-split data-split-now data-split-delay="0.25">
          Sebastian<br />Køster
        </h1>
        <div class="hero-intro" data-reveal data-reveal-delay="0.6">
          <p class="lede">
            Fullstack engineer and frontend developer at Dreamplan. I bring stories to life in code, in games and in
            sound.
          </p>
          <div class="btn-row">
            <a class="btn" href="/work/">See my work</a>
            <a class="btn btn--ghost" href="/cv/">Read my CV</a>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-ticker">
      <Ticker items={skills} />
    </div>
  </section>

  <!-- ---------- Editorial intro, the old three-column layout ---------- -->
  <section class="wrap editorial" aria-labelledby="hello">
    <aside class="side">
      <nav aria-label="Shortcuts">
        <ul>
          {
            [
              ['work', '/work/'],
              ['about', '/about/'],
              ['cv', '/cv/'],
              ['contact', '/contact/'],
            ].map(([label, href]) => (
              <li>
                <a class="arrow-link" href={href}>
                  {label}
                  <Arrow />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ul class="side-socials">
        {
          socials
            .filter((s) => s.url.startsWith('http'))
            .map((s) => (
              <li>
                <a class="social" href={s.url} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
                  <SocialIcon name={s.label} />
                </a>
              </li>
            ))
        }
      </ul>
    </aside>

    <div class="center">
      <h2 id="hello" class="hello" data-split>Hello!</h2>
      <div class="hello-photo" data-reveal>
        <Image src={profile} alt="Sebastian smiling, in a cap and glasses" widths={[400, 700]} sizes="(min-width: 900px) 35vw, 90vw" />
      </div>
      <div class="hello-head">
        <h3>Hi there! <em>Welcome</em> to my portfolio.</h3>
        <p class="mono row"><span>Portfolio</span><span>Introduction</span></p>
      </div>
      <div class="hello-text" data-reveal>
        <p>
          I'm Sebastian, a fullstack engineer and frontend developer at Dreamplan in Copenhagen. I like the whole
          journey of a product, from a rough idea to the last tiny detail on screen, and I like it best when there's a
          story underneath.
        </p>
        <p>
          Before code I spent years as a chef in some of the best kitchens around, and even longer making music, so I'm used to high standards, tight
          timing and working in a team. Today I put all of that into products people use every day, and into the
          games I make with my partner at Kinda Whimsical Games.
        </p>
      </div>
      <a class="more arrow-link" href="/about/">more about me <Arrow /></a>
    </div>

    <div class="facts">
      <div class="facts-head">
        <h3>About me:</h3>
        <p class="muted">Quick facts</p>
      </div>
      <ol>
        {
          facts.map((f, i) => (
            <li data-reveal data-reveal-delay={String((i % 3) * 0.05)}>
              <div class="fact-top">
                <span class="num display">{i + 1}</span>
                <span class="mono muted">{f.tag}</span>
              </div>
              <h4>{f.title}</h4>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ---------- Selected work ---------- -->
  <section class="wrap work" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title" class="section-title" data-split>Selected work</h2>
      <a class="arrow-link" href="/work/">all {total} projects <Arrow /></a>
    </div>
    <WorkList entries={featured} />
  </section>

  <!-- ---------- Journey ---------- -->
  <section class="wrap journey" aria-labelledby="journey-title">
    <div class="section-head">
      <h2 id="journey-title" class="section-title" data-split>From kitchen<br />to code</h2>
      <p class="lede muted journey-lede" data-reveal>
        Every job I've had has been about making something for someone else to enjoy. The tools changed. The craft didn't.
      </p>
    </div>
    <ol class="journey-list">
      {
        journey.map((j, i) => (
          <li data-reveal data-reveal-delay={String(i * 0.1)}>
            <div class="journey-img">
              <Image src={j.img} alt={j.alt} widths={[400, 700]} sizes="(min-width: 900px) 30vw, 90vw" data-parallax="8" />
            </div>
            <p class="mono muted">{j.years}</p>
            <h3>{j.title}</h3>
            <p>{j.text}</p>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding: var(--gap);
    padding-bottom: 0;
  }

  .hero-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: calc(100svh - 2 * var(--gap) - 3rem);
    padding: clamp(4rem, 8vw, 5.5rem) clamp(1.25rem, 3vw, 2.5rem) clamp(1.25rem, 3vw, 2.5rem);
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-card :global(.contour) {
    z-index: -1;
  }

  .hero-top {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0 rgb(66 190 91 / 0.6);
    animation: pulse 2.2s ease-out infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px rgb(66 190 91 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(66 190 91 / 0);
    }
  }

  .hero-portrait {
    position: absolute;
    top: clamp(5rem, 12vh, 8rem);
    right: clamp(1.25rem, 6vw, 7rem);
    width: clamp(280px, 36vw, 560px);
    aspect-ratio: 16 / 10;
    margin: 0;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgb(20 20 20 / 0.5);
    rotate: 1.5deg;
  }

  .hero-portrait :global(img) {
    width: 100%;
    height: 116%;
    object-fit: cover;
    object-position: 40% 35%;
  }

  .hero-bottom {
    grid-row: 3;
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    align-items: end;
    gap: 2rem;
  }

  .hero-name {
    font-size: min(var(--step-5), 10.2vw);
    line-height: 0.8;
    white-space: nowrap;
  }

  .hero-intro {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-bottom: 0.6rem;
  }

  .btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .hero-ticker {
    margin-top: 0.6rem;
  }

  /* ---------- Editorial ---------- */
  .editorial {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1.25fr) minmax(0, 1fr);
    margin-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--line);
  }

  .editorial > * {
    padding: 1.75rem clamp(1rem, 2.5vw, 2.25rem);
  }

  .side {
    position: sticky;
    top: 5rem;
    align-self: start;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 70vh;
    padding-left: 0;
  }

  .side ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.15rem;
  }

  .side-socials {
    display: flex !important;
    gap: 0.4rem !important;
  }

  .social {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s,
      transform 0.4s var(--ease-out);
  }

  .social :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .social:hover,
  .social:focus-visible {
    background: var(--green);
    border-color: var(--green);
    transform: translateY(-3px);
  }

  .center {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    border-inline: 1px solid var(--line);
  }

  .hello {
    font-size: clamp(4rem, 2rem + 7vw, 9rem);
    text-transform: none;
    font-stretch: 75%;
    letter-spacing: -0.02em;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .hello-photo {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 50% 50% 0.75rem 0.75rem / 60% 60% 0.75rem 0.75rem;
    background: var(--paper-2);
  }

  .hello-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  .hello-head {
    display: grid;
    gap: 0.4rem;
  }

  .hello-head h3 {
    font-size: var(--step-2);
    font-weight: 500;
  }

  .hello-head em {
    font-family: Georgia, serif;
    font-weight: 400;
  }

  .row {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
  }

  .hello-text {
    font-size: 1.05rem;
  }

  .more {
    justify-self: end;
    font-size: 1.35rem;
  }

  .facts-head {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .facts-head h3 {
    font-family: Georgia, serif;
    font-weight: 400;
    font-size: var(--step-1);
  }

  .facts ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .fact-top {
    display: flex;
    justify-content: space-between;
    align-items: start;
  }

  .num {
    font-size: 3.2rem;
    font-weight: 500;
    font-stretch: 80%;
    color: var(--green);
    line-height: 0.8;
  }

  .facts h4 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 650;
    font-stretch: 90%;
  }

  .facts p {
    font-size: 0.92rem;
    color: var(--ink-2);
  }

  /* ---------- Sections ---------- */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-bottom: 1.5rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--ink);
  }

  .section-title {
    font-size: var(--step-4);
  }

  .section-head .arrow-link {
    font-size: 1.15rem;
  }

  .work,
  .journey {
    margin-top: clamp(6rem, 12vw, 11rem);
  }

  .journey-lede {
    max-width: 34ch;
  }

  .journey-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .journey-list li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .journey-img {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .journey-img :global(img) {
    width: 100%;
    height: 120%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.6s ease;
  }

  .journey-list li:hover .journey-img :global(img) {
    filter: none;
  }

  .journey-list p:last-child {
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    .editorial {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .side {
      display: none;
    }

    .center {
      border-left: 0;
    }
  }

  @media (max-width: 820px) {
    .hero-name {
      font-size: 19vw;
    }

    .hero-bottom {
      grid-template-columns: 1fr;
    }

    .hero-portrait {
      position: relative;
      top: auto;
      right: auto;
      width: 80%;
      justify-self: end;
      margin-block: 1.5rem 2rem;
    }

    .hero-card {
      grid-template-rows: auto auto auto;
    }

    .hero-top {
      flex-direction: column;
      gap: 0.3rem;
    }

    .editorial {
      grid-template-columns: 1fr;
    }

    .center {
      border: 0;
    }

    .editorial > * {
      padding-inline: 0;
    }

    .journey-list {
      grid-template-columns: 1fr;
    }
  }
</style>
