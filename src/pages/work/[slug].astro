---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkMedia from '../../components/WorkMedia.astro';
import Arrow from '../../components/Arrow.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: entries[(i + 1) % entries.length], index: i, total: entries.length },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
  index: number;
  total: number;
}

const { entry, next, index, total } = Astro.props;
const { Content } = await render(entry);
const { title, summary, category, year, role, client, stack, links, poster } = entry.data;
---

<Base title={title} description={summary} image={poster}>
  <article>
    <header class="wrap head">
      <div class="crumbs">
        <a class="arrow-link back" href="/work/">all work</a>
        <span class="mono muted">{String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
      </div>
      <p class="mono cat">{category}</p>
      <h1 class="title" data-split data-split-now>{title}</h1>
      <p class="lede" data-reveal data-reveal-delay="0.3">{summary}</p>
    </header>

    <dl class="wrap meta" data-reveal data-reveal-delay="0.4">
      <div>
        <dt class="mono">Role</dt>
        <dd>{role}</dd>
      </div>
      {
        client && (
          <div>
            <dt class="mono">Client</dt>
            <dd>{client}</dd>
          </div>
        )
      }
      <div>
        <dt class="mono">Year</dt>
        <dd>{year}</dd>
      </div>
      {
        stack.length > 0 && (
          <div class="stack">
            <dt class="mono">Tools</dt>
            <dd>
              <ul class="chips">
                {stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
    </dl>

    <div class="wrap hero-media" data-reveal data-reveal-delay="0.5">
      <WorkMedia entry={entry} eager sizes="(min-width: 1440px) 1400px, 100vw" />
    </div>

    <section class="wrap story">
      <h2 class="mono story-label">The story</h2>
      <div class="prose" data-reveal>
        <Content />
        {
          links.length > 0 && (
            <div class="links">
              {links.map((l, i) => (
                <a
                  class:list={['btn', { 'btn--ghost': i > 0 }]}
                  href={l.url}
                  {...(l.url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {l.label}
                  <Arrow />
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <a class="wrap next" href={`/work/${next.id}/`}>
      <span class="mono muted">Next project</span>
      <span class="next-row">
        <span class="next-title display">{next.data.title}</span>
        <span class="next-media">
          <WorkMedia entry={next} lazyClip sizes="320px" />
        </span>
      </span>
    </a>
  </article>
</Base>

<style>
  .head {
    display: grid;
    gap: 1rem;
    padding-top: clamp(6.5rem, 12vw, 9rem);
  }

  .crumbs {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .back {
    font-size: 1.1rem;
  }

  .cat {
    color: var(--green-ink);
    margin-top: 1.5rem;
  }

  .title {
    font-size: min(var(--step-5), 14vw);
    overflow-wrap: anywhere;
  }

  .lede {
    max-width: 40ch;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem 2rem;
    margin-block: 2.5rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
  }

  .meta .stack {
    grid-column: span 2;
  }

  dt {
    color: var(--ink-2);
    margin-bottom: 0.4rem;
  }

  dd {
    margin: 0;
    font-weight: 550;
  }

  .hero-media {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .story-label {
    position: sticky;
    top: 6rem;
    align-self: start;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--green-ink);
  }

  .prose {
    display: grid;
    gap: 1.25rem;
    font-size: clamp(1.1rem, 1rem + 0.35vw, 1.3rem);
    line-height: 1.55;
  }

  .prose :global(p + p) {
    margin-top: 0;
  }

  .prose :global(p:first-child) {
    font-size: 1.2em;
    line-height: 1.4;
    font-stretch: 95%;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .links :global(svg) {
    width: 0.9em;
    height: 0.9em;
  }

  .next {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(5rem, 10vw, 9rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink);
    color: inherit;
    text-decoration: none;
  }

  .next-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .next-title {
    font-size: var(--step-5);
    transition:
      color 0.4s,
      transform 0.6s var(--ease-out);
  }

  .next:hover .next-title {
    color: var(--green-ink);
    transform: translateX(1rem);
  }

  .next-media {
    flex-shrink: 0;
    width: clamp(160px, 22vw, 320px);
    aspect-ratio: 4 / 3;
    border-radius: 0.75rem;
    overflow: hidden;
    rotate: 3deg;
    transition: rotate 0.6s var(--ease-out);
  }

  .next:hover .next-media {
    rotate: 0deg;
  }

  @media (max-width: 820px) {
    .story {
      grid-template-columns: 1fr;
    }

    .story-label {
      position: static;
    }

    .meta .stack {
      grid-column: 1 / -1;
    }

    .next-media {
      display: none;
    }
  }
</style>

<script>
  // The next project's footage plays when you hover it
  const next = document.querySelector<HTMLElement>('.next');
  const v = next?.querySelector('video');
  if (next && v) {
    next.addEventListener('pointerenter', () => v.play().catch(() => {}));
    next.addEventListener('pointerleave', () => v.pause());
  }
</script>
