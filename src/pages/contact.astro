---
import Base from '../layouts/Base.astro';
import Contour from '../components/Contour.astro';
import Arrow from '../components/Arrow.astro';
import { site, socials } from '../site';

const topics = [
  {
    tag: 'Product',
    title: 'Frontend & product work',
    text: 'Interfaces, design systems and the kind of frontend detail that makes a product feel calm and trustworthy.',
  },
  {
    tag: 'Games',
    title: 'Games & interactive',
    text: 'WebGL, React Three Fiber and playful web experiences, or a chat about what we make at Kinda Whimsical Games.',
  },
  {
    tag: 'Audio',
    title: 'Music & sound design',
    text: 'Scores, soundscapes and sound design for games, theatre and film.',
  },
];
const external = socials.filter((s) => s.url.startsWith('http'));
---

<Base title="Contact" description="Get in touch with Sebastian Køster." bareFooter>
  <section class="hero" data-contour-area>
    <Contour tone="dark" density={9} />
    <div class="wrap hero-inner">
      <p class="mono label">Contact</p>
      <h1 class="title" data-split data-split-now>Let's<br />connect</h1>
      <p class="lede">
        Whether it's a role, a project, a game idea or just a hello, I'd love to hear from you. Email is the
        quickest way to reach me.
      </p>
      <div class="mail-row">
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        <button type="button" class="copy" data-copy={site.email}>
          <span class="copy-label">Copy</span>
        </button>
      </div>
      <ul class="socials">
        {
          external.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener">
                <span class="display">{s.label}</span>
                <Arrow />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap topics" aria-labelledby="topics">
    <h2 id="topics" class="h" data-split>Let's talk about</h2>
    <ol>
      {
        topics.map((t, i) => (
          <li data-reveal data-reveal-delay={String(i * 0.08)}>
            <div class="t-top">
              <span class="num display">{i + 1}</span>
              <span class="mono muted">{t.tag}</span>
            </div>
            <h3>{t.title}</h3>
            <p class="muted">{t.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="mono status"><span class="dot" aria-hidden="true"></span> Based in {site.location}. Happy to talk in Danish or English.</p>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    color: var(--paper-2);
    background: var(--night);
    overflow: hidden;
    isolation: isolate;
  }

  .hero :global(.contour) {
    z-index: -1;
  }

  .hero-inner {
    display: grid;
    gap: 1.75rem;
    padding-block: clamp(7rem, 14vw, 10rem) clamp(3rem, 6vw, 5rem);
  }

  .label {
    color: var(--green);
  }

  .title {
    font-size: var(--step-5);
  }

  .lede {
    max-width: 42ch;
    color: rgb(242 240 236 / 0.8);
  }

  .mail-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .mail {
    font-size: clamp(1.4rem, 0.8rem + 2.6vw, 3rem);
    font-weight: 500;
    font-stretch: 85%;
    color: var(--paper-2);
    text-decoration: none;
    border-bottom: 2px solid var(--green);
    overflow-wrap: anywhere;
  }

  .mail:hover {
    color: var(--green);
  }

  .copy {
    padding: 0.55em 1.1em;
    font: 550 0.9rem / 1 var(--font);
    color: var(--paper-2);
    background: transparent;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 999px;
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }

  .copy:hover,
  .copy.is-done {
    background: var(--green);
    border-color: var(--green);
    color: var(--ink);
  }

  .socials {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(255 255 255 / 0.15);
  }

  .socials a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1rem 1.25rem 0;
    color: var(--paper-2);
    text-decoration: none;
  }

  .socials .display {
    font-size: clamp(2rem, 1.2rem + 3vw, 3.75rem);
    transition: color 0.3s;
  }

  .socials :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
    transition: transform 0.5s var(--ease-out);
  }

  .socials a:hover .display {
    color: var(--green);
  }

  .socials a:hover :global(svg) {
    transform: rotate(45deg);
    color: var(--green);
  }

  .topics {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .h {
    font-size: var(--step-4);
    margin-bottom: 2rem;
  }

  .topics ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topics li {
    display: grid;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
  }

  .t-top {
    display: flex;
    justify-content: space-between;
  }

  .num {
    font-size: 3rem;
    font-weight: 500;
    font-stretch: 80%;
    color: var(--green);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--green);
  }

  @media (max-width: 820px) {
    .socials,
    .topics ol {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('.copy-label')!;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = 'Copied';
        btn.classList.add('is-done');
        setTimeout(() => {
          label.textContent = 'Copy';
          btn.classList.remove('is-done');
        }, 2000);
      } catch {
        location.href = `mailto:${btn.dataset.copy}`;
      }
    });
  });
</script>
