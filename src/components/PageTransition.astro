---
/**
 * Loader + page transition. Every page opens behind the green/black curtain with a
 * progress line; it lifts once fonts and the first images are ready, then the page's
 * own animations start. Clicking an internal link brings the curtain back in.
 */
import { site } from '../site';
import Contour from './Contour.astro';
---

<script is:inline>
  try {
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('pt-in');
  } catch (e) {}
</script>

<div class="pt" aria-hidden="true">
  <div class="pt-panel green"></div>
  <div class="pt-panel ink">
    <Contour tone="dark" density={11} instant class="pt-contour" />
    <div class="pt-loader">
      <span class="pt-label display">{site.name}</span>
      <span class="pt-bar"><span class="pt-fill"></span></span>
      <span class="pt-count mono">0</span>
    </div>
  </div>
</div>

<style>
  .pt {
    position: fixed;
    inset: 0;
    z-index: 400;
    pointer-events: none;
  }

  .pt-panel {
    position: absolute;
    inset: 0;
    transform: translateX(101%);
  }

  .green {
    background: var(--green);
  }

  .ink {
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--paper);
    isolation: isolate;
    overflow: hidden;
  }

  .ink :global(.pt-contour) {
    z-index: -1;
  }

  /* Soft dark glow behind the name so the lines don't run through it */
  .ink::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse 38% 30% at 50% 50%, rgb(17 19 17 / 0.92), rgb(17 19 17 / 0) 100%);
    pointer-events: none;
  }

  .pt-loader {
    position: relative;
  }

  .pt-loader {
    display: grid;
    justify-items: start;
    gap: 1rem;
    width: min(520px, 80vw);
  }

  .pt-label {
    font-size: clamp(2.4rem, 7vw, 5rem);
  }

  .pt-bar {
    position: relative;
    width: 100%;
    height: 2px;
    background: rgb(255 255 255 / 0.15);
    overflow: hidden;
  }

  .pt-fill {
    position: absolute;
    inset: 0;
    background: var(--green);
    transform-origin: left center;
    transform: scaleX(0);
  }

  .pt-count {
    justify-self: end;
    color: var(--green);
    font-variant-numeric: tabular-nums;
  }

  /* Page load: start covered, the script lifts the curtain when the page is ready */
  :global(html.pt-in) .pt-panel {
    transform: none;
  }

  :global(html.pt-in) {
    overflow: hidden;
  }
</style>

<script>
  import { gsap } from 'gsap';

  const html = document.documentElement;
  const panels = document.querySelectorAll<HTMLElement>('.pt-panel');
  const fill = document.querySelector<HTMLElement>('.pt-fill');
  const count = document.querySelector<HTMLElement>('.pt-count');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const done = () => {
    (window as any).__siteReady = true;
    window.dispatchEvent(new Event('site:ready'));
  };

  // What "ready" means: fonts plus the images and posters in the first screen
  function whenReady(): Promise<void> {
    const imgs = [...document.images].filter((i) => i.loading !== 'lazy' && !i.complete);
    const loads = imgs.map((i) => new Promise<void>((r) => ((i.onload = () => r()), (i.onerror = () => r()))));
    const total = loads.length + 1;
    let n = 0;
    const tick = () => {
      n++;
      progress.target = Math.max(progress.target, Math.min(0.95, n / total));
    };
    loads.forEach((p) => p.then(tick));
    const fonts = document.fonts.ready.then(tick);
    const all = Promise.all([fonts, ...loads]).then(() => {});
    const cap = new Promise<void>((r) => setTimeout(r, 3000)); // never hold the page hostage
    return Promise.race([all, cap]);
  }

  // Smoothly animated progress number and line
  const progress = { value: 0, target: 0.15 };
  gsap.ticker.add(() => {
    progress.value += (progress.target - progress.value) * 0.12;
    if (fill) fill.style.transform = `scaleX(${progress.value})`;
    if (count) count.textContent = String(Math.round(progress.value * 100));
  });

  async function reveal() {
    if (!html.classList.contains('pt-in')) return done();
    let first = false;
    try {
      first = !sessionStorage.getItem('sk-visited');
      sessionStorage.setItem('sk-visited', '1');
    } catch (e) {}
    const minTime = new Promise((r) => setTimeout(r, first ? 1600 : 700));
    await Promise.all([whenReady(), minTime]);
    progress.target = 1;
    await new Promise((r) => setTimeout(r, 350));
    // Pin both panels in place before dropping the class, so neither jumps back to the right
    gsap.set(panels, { xPercent: 0 });
    html.classList.remove('pt-in');
    gsap.to([...panels].reverse(), {
      xPercent: -101,
      duration: 0.9,
      ease: 'expo.inOut',
      stagger: 0.1,
      onStart: () => {
        setTimeout(done, 350);
      },
      onComplete: () => gsap.set(panels, { clearProps: 'transform' }),
    });
  }

  function leave(href: string) {
    progress.value = 0;
    progress.target = 0.15;
    gsap.fromTo(
      panels,
      { xPercent: 101 },
      { xPercent: 0, duration: 0.65, ease: 'expo.inOut', stagger: 0.1, onComplete: () => (location.href = href) },
    );
  }

  document.addEventListener('click', (e) => {
    if (reduce || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as HTMLElement).closest('a');
    if (!a || a.target || a.hasAttribute('download')) return;
    const url = new URL(a.href, location.href);
    if (url.origin !== location.origin || /\.(pdf|jpg|png|mp4|zip)$/i.test(url.pathname)) return;
    if (url.pathname === location.pathname && url.hash) return;
    e.preventDefault();
    leave(url.href);
  });

  // Coming back with the browser's back button can restore a covered page
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      html.classList.remove('pt-in');
      gsap.set(panels, { xPercent: 101 });
    }
  });

  reveal();
</script>
