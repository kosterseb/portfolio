---
/**
 * The visual for a project: a silent loop, a cover image, or (when there's neither)
 * a typographic cover with the project's name over contour lines.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  sizes?: string;
  eager?: boolean;
  /** Only load and play the clip when asked (hover previews). */
  lazyClip?: boolean;
}
const { entry, sizes = '(min-width: 900px) 50vw, 100vw', eager = false, lazyClip = false } = Astro.props;
const { title, cover, clip, poster, category } = entry.data;
---

<div class="media">
  {
    clip ? (
      <video
        data-autoplay={lazyClip ? undefined : ''}
        muted
        loop
        playsinline
        preload={lazyClip ? 'none' : 'metadata'}
        poster={poster}
        aria-label={`${title} footage`}
      >
        <source src={clip.replace(/\.mp4$/, '.webm')} type="video/webm" />
        <source src={clip} type="video/mp4" />
      </video>
    ) : cover ? (
      <Image
        src={cover}
        alt={`${title} screenshot`}
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <div class="type-cover">
        <span class="mono">{category}</span>
        <span class="display">{title}</span>
      </div>
    )
  }
</div>

<style>
  .media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--paper-3);
  }

  .media video,
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .type-cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    color: var(--paper-2);
    background:
      repeating-radial-gradient(circle at 78% 30%, transparent 0 18px, rgb(255 255 255 / 0.08) 18px 19px),
      radial-gradient(circle at 78% 30%, rgb(66 190 91 / 0.35), transparent 60%),
      var(--night);
  }

  .type-cover .mono {
    color: var(--green);
  }

  .type-cover .display {
    font-size: clamp(2.2rem, 7cqi, 5.5rem);
    line-height: 0.85;
  }

  .media {
    container-type: inline-size;
  }
</style>
