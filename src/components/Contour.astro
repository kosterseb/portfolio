---
/**
 * Live topographic map drawn in WebGL: contour lines flow slowly over time,
 * and the cursor pushes up a hill that turns the nearby lines green.
 * Falls back to a still pattern without WebGL2 or with reduced motion.
 */
interface Props {
  tone?: 'light' | 'dark';
  density?: number;
  class?: string;
}
const { tone = 'light', density = 9, class: className } = Astro.props;
---

<div class:list={['contour', tone, className]} data-contour data-tone={tone} data-density={density} aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .contour {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: var(--paper-3);
    /* Still fallback until (or unless) WebGL takes over */
    background-image: repeating-radial-gradient(
      ellipse at 30% 40%,
      transparent 0 22px,
      rgb(20 20 20 / 0.1) 22px 23px
    );
  }

  .contour.dark {
    background-color: var(--night);
    background-image: repeating-radial-gradient(
      ellipse at 70% 30%,
      transparent 0 22px,
      rgb(255 255 255 / 0.07) 22px 23px
    );
  }

  canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .contour.is-live canvas {
    opacity: 1;
  }
</style>

<script>
  import { mountContour } from '../scripts/contour';
  document.querySelectorAll<HTMLElement>('[data-contour]').forEach(mountContour);
</script>
